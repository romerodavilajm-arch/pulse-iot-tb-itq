# Copia este archivo a .env (cp .env.example .env) y rellena los valores.
# .env está en .gitignore: el token no se sube al repo.

# Servidor de ThingsBoard (sin https://). En ThingsBoard Cloud EU: eu.thingsboard.cloud
TB_HOST=thingsboard.cloud
TB_MQTT_PORT=1883

# Access Token del dispositivo test-pi
# (ThingsBoard > Entidades > Dispositivos > test-pi > Copiar token de acceso)
TB_DEVICE_TOKEN=pega-aqui-el-token-de-test-pi

# Si ThingsBoard rechaza el mensaje por MQTT (tamaño), reintentar por la API HTTP
# de dispositivos con el mismo JSON. 1 = sí, 0 = no.
HTTP_FALLBACK=1
# TB_HTTP_URL=https://thingsboard.cloud   # por defecto https://TB_HOST

# Duración de la sesión en segundos (300 = 5 minutos)
SESSION_SECONDS=300

# Dirección I2C del LCD (suele ser 0x27; algunos módulos usan 0x3F). "none" = sin LCD.
LCD_ADDRESS=0x27

# IR medio a partir del cual se considera que hay dedo (igual que MIN_IR_MEAN de la web)
FINGER_IR_MIN=50000
# Corriente de los LED del MAX30102 (0x24 ~ 7 mA). Súbela (0x30, 0x3F) si el IR sale bajo.
LED_CURRENT=0x24
