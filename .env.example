# Copia este archivo a .env y rellena los valores. .env está en .gitignore.
TB_URL=https://thingsboard.cloud
TB_API_KEY=pega-aqui-tu-api-key
# Uno o varios Device ID separados por comas (sin espacios), p. ej. la Pi 5 y la Pi simulada:
# TB_DEVICE_ID=id-de-test-pi,id-de-pi-simulada
TB_DEVICE_ID=pega-aqui-el-device-id-de-test-pi

# Opcional: si los dejas vacíos, /admin responde 404.
ADMIN_USER=
ADMIN_PASS=
